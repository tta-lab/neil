{
  "name": "neil",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "resume:build": "typst compile --font-path \"${TYPST_FONT_PATH:-/run/current-system/sw/share/fonts}\" resume/sustech-resume.typ resume/sustech-resume.pdf",
    "resume:watch": "typst watch --font-path \"${TYPST_FONT_PATH:-/run/current-system/sw/share/fonts}\" resume/sustech-resume.typ resume/sustech-resume.pdf",
    "deploy:prod": "bun run build && wrangler deploy --env prod"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "marked": "^18.0.5"
  }
}
